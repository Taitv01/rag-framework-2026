# Ultimate RAG Framework - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Keys
# =============================================================================

# OpenAI (GPT-4, GPT-3.5, Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional custom endpoints / proxies
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Cohere (Embeddings, Re-ranking)
COHERE_API_KEY=your_cohere_api_key_here

# =============================================================================
# Vector Database Configuration
# =============================================================================

# Vector store backend.
# Local/dev default: faiss
# Docker production profile: qdrant
DEFAULT_VECTOR_STORE=faiss
DEFAULT_COLLECTION_NAME=default

# Qdrant (Production)
# Use http://qdrant:6333 inside docker-compose.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Weaviate (Production)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Neo4j (Graph RAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =============================================================================
# Model Configuration
# =============================================================================

# Default LLM provider
DEFAULT_LLM_PROVIDER=openai

# Default LLM model
DEFAULT_LLM_MODEL=gpt-4o

# Default embedding model (2026 recommended: BAAI/bge-m3)
# Options:
#   - BAAI/bge-m3 (default, recommended 2026 baseline, dense+sparse+ColBERT hybrid, 1024d)
#   - keepitreal/vietnamese-sbert (legacy default, Vietnamese SBERT, 768d)
#   - bkai-foundation-models/vietnamese-bi-encoder (PhoBERT-based, 768d)
#   - AITeamVN/Vietnamese_Embedding (bge-m3-based, 1024d, best Vietnamese benchmarks)
#   - intfloat/multilingual-e5-large-instruct (top multilingual performer, 1024d)
#   - Alibaba-NLP/gte-Qwen2-7B-instruct (premium, long context 32k, 3584d)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (multilingual, lightweight)
#   - all-MiniLM-L6-v2 (English-only, fast)
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3

# Default re-ranking model (Vietnamese-aware)
# Options:
#   - AITeamVN/Vietnamese_Reranker (default, best for Vietnamese)
#   - Qwen/Qwen3-Reranker-0.6B (top open-source, multilingual, 32k context)
#   - BAAI/bge-reranker-v2-m3 (reliable lightweight multilingual baseline)
#   - cross-encoder/ms-marco-MiniLM-L-6-v2 (English-only, fallback)
DEFAULT_RERANKER_MODEL=AITeamVN/Vietnamese_Reranker

# =============================================================================
# RAG Configuration
# =============================================================================

# Chunk size for text splitting
CHUNK_SIZE=500

# Chunk overlap
CHUNK_OVERLAP=50

# Number of documents to retrieve
RETRIEVAL_K=5

# Enable hybrid search (vector + BM25)
ENABLE_HYBRID_SEARCH=true

# Enable re-ranking after retrieval
ENABLE_RERANKING=true

# =============================================================================
# API Security
# =============================================================================

# Enable API key protection for data endpoints (/query, /documents, /ingest, /search)
ENABLE_API_AUTH=false

# Comma-separated API keys accepted when ENABLE_API_AUTH=true
API_KEYS=rag_local_dev_key

# Sliding-window rate limit per IP/API key
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Maximum upload size per file
MAX_UPLOAD_SIZE_MB=25

# =============================================================================
# Docker Compose Ports
# =============================================================================

RAG_API_PORT=8000
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

# Docker-only service URLs. These intentionally use compose service names.
DOCKER_DEFAULT_VECTOR_STORE=qdrant
DOCKER_COLLECTION_NAME=rag_documents
DOCKER_QDRANT_URL=http://qdrant:6333
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_ENABLE_API_AUTH=true

# =============================================================================
# Caching
# =============================================================================

# Enable response caching
ENABLE_CACHE=true

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Redis URL (for distributed caching)
REDIS_URL=redis://localhost:6379

# =============================================================================
# Web Search (optional, for retrieval fallback)
# =============================================================================

# Tavily API (optimized for RAG, recommended)
# Get key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# DuckDuckGo (free, no API key needed - just install duckduckgo-search)

# =============================================================================
# Logging
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose logging for LangChain
LANGCHAIN_VERBOSE=false

# =============================================================================
# Langfuse Observability (LLM tracing & monitoring)
# =============================================================================

# Langfuse API keys (get from https://langfuse.com)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
