# Ultimate RAG Framework - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM API Keys
# =============================================================================

# OpenAI (GPT-4, GPT-3.5, Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere (Embeddings, Re-ranking)
COHERE_API_KEY=your_cohere_api_key_here

# =============================================================================
# Vector Database Configuration
# =============================================================================

# Qdrant (Production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Weaviate (Production)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Neo4j (Graph RAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# =============================================================================
# Model Configuration
# =============================================================================

# Default LLM model
DEFAULT_LLM_MODEL=gpt-4o

# Default embedding model
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Default re-ranking model
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================================================
# RAG Configuration
# =============================================================================

# Chunk size for text splitting
CHUNK_SIZE=500

# Chunk overlap
CHUNK_OVERLAP=50

# Number of documents to retrieve
RETRIEVAL_K=5

# Enable hybrid search (vector + BM25)
ENABLE_HYBRID_SEARCH=true

# Enable re-ranking after retrieval
ENABLE_RERANKING=true

# =============================================================================
# Caching
# =============================================================================

# Enable response caching
ENABLE_CACHE=true

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Redis URL (for distributed caching)
REDIS_URL=redis://localhost:6379

# =============================================================================
# Logging
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose logging for LangChain
LANGCHAIN_VERBOSE=false
